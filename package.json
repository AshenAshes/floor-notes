{
  "name": "gemini-obsidian-plugin",
  "version": "1.2.0",
  "description": "Floor notes Obsidian plugin",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/build-css.mjs && node esbuild.config.mjs",
    "build": "node scripts/build-css.mjs && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\"",
    "check:css": "node scripts/check-css.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run check:css && npm run check:source && npm run check:locales && npm run check:theme-contrast && npm run test && npm run build && npm run check:release"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.1",
    "unicode-segmenter": "0.10.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.2.0",
    "eslint-plugin-obsidianmd": "0.4.0",
    "jsdom": "^24.0.0",
    "obsidian": "1.8.7",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
